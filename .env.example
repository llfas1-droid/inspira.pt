# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GEMINI_MODEL: Model identifier for structured proposal interpretation (default: gemini-3.8-flash)
GEMINI_MODEL="gemini-3.8-flash"

# APP_BASE_URL: Public URL of the applet for proposal links (can use APP_URL or custom domain)
APP_BASE_URL="MY_APP_BASE_URL"

# RESEND_API_KEY: Resend API key (starts with re_...) for student notifications
RESEND_API_KEY="MY_RESEND_API_KEY"

# EMAIL_ALUNO: The email address associated with the student's Resend account
EMAIL_ALUNO="aluno@exemplo.com"

# ADMIN_UID: The Firebase Auth UID authorized to access the /admin area
ADMIN_UID="MY_FIREBASE_ADMIN_UID"
